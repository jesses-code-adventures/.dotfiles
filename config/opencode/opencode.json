{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect",
          "--no-usage-statistics"
        ]
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "/Users/jesse/.local/bin/codebase-memory-mcp"
        ]
      },
      "papi-admin": {
        "type": "remote",
        "url": "http://localhost:8092/mcp",
        "oauth": false,
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {env:PAPI_ADMIN_MCP_API_KEY}"
        }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ]
}
